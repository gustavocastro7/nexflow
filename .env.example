# Copy to .env for local dev. In Vercel, set these under Project Settings > Environment Variables.

NODE_ENV=production
PORT=3000

# Always use MongoDB Atlas, both for local dev and production (Vercel functions
# cannot connect to a local/docker-only MongoDB, so there is no local DB option).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Required in production - the app throws if this is missing. Generate a strong
# random value, e.g.: openssl rand -base64 48
JWT_SECRET=

# JSON array of bootstrap admin users, e.g.:
# [{"name":"Admin","email":"admin@example.com","password":"...","profile":"jedi"}]
JEDI_USERS=
